# Maintainer: Ivy Duggan <ivylikethevine@gmail.com>
#
# The versioned package, cut from a tagged release tarball. packaging/bump.sh
# rewrites pkgver and b2sums together; do not edit either by hand.
# say-hi-git/ is the same package built from the branch instead.

pkgname=say-hi
pkgver=0.1.2
pkgrel=1
pkgdesc="sshrc supercharged - your shell config, on every host you say hi to"
arch=('any')
url="https://github.com/ivylikethevine/say-hi"
license=('MIT')
# tar, coreutils, gawk and sed are used too, but they are in base - namcap
# flags depending on those explicitly.
# coreutils is in `base`, which packaging guidelines say to assume; openssh is
# not, and hi runs ssh itself
depends=('bash' 'openssh')
optdepends=('zsh: zsh support on the client'
  'fish: fish support on the client'
  'docker: container targets'
  'podman: container targets'
  'nomad: allocation targets'
  'kubectl: pod targets')
# the release asset, not GitHub's auto-generated /archive/ tarball: the asset
# is built by the release, listed in its SHA256SUMS and covered by its build
# provenance. It is already named $pkgname-$pkgver.tar.gz, so no `::` rename.
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
# never submit with SKIP - packaging/bump.sh <version> fills in the real sum
b2sums=('2c75e84f2e516bee1be531a53162bb0791c951d2d20b76ae1d4c650a89c4658142aa4400815bf8fb843e4af65222cf713ab0cc19b46a723ac4eb4765a5be13dd')

prepare() {
  # scripts/install.sh derives $_HI_HOME as <checkout>/.. and then looks for
  # $_HI_HOME/say-hi, so the checkout has to be named exactly say-hi - and the
  # tarball unpacks to say-hi-$pkgver (packaging/lib.sh's src_tarball builds it
  # with exactly that prefix). A symlink rather than a mv: it is idempotent, so
  # `makepkg -e` over an existing $srcdir stays a no-op.
  ln -sfn "$srcdir/$pkgname-$pkgver" "$srcdir/say-hi"
}

package() {
  # install.sh's packaging mode is the whole of package(): it copies
  # $_HI_PACKAGE_CONTENTS to $DESTDIR/usr/share/say-hi, links /usr/bin/hi at the
  # *installed* location (no $pkgdir in the link target), and writes the
  # /etc/profile.d snippet that exports _HI_HOME=/usr/share. Copying by hand
  # here instead would be a second copy of that list, free to drift.
  DESTDIR="$pkgdir" "$srcdir/say-hi/scripts/install.sh" --prefix /usr/share

  # `hi --version` and `man hi`'s footer answer with pkgver. Stamped at build
  # time because the tarball cannot carry it: bump.sh's manifest pass runs
  # after the tag exists, so a committed stamp would always be stale here.
  # packaging/stamp.sh is the one implementation every channel calls; makepkg
  # sets SOURCE_DATE_EPOCH, so the man page's date is reproducible.
  "$srcdir/say-hi/packaging/stamp.sh" --root "$pkgdir" --version "$pkgver"

  # Arch wants the licence here as well; install_tree's copy lives inside the
  # tree, where it is what `hi` ships to a target rather than what pacman reads.
  install -Dm644 "$srcdir/say-hi/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
