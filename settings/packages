# probed for, and hi carries on without them - but the session is worse for it:
# an unbounded backend probe, or a "?" where the header's system info should be
# The same grouping rule as the package managers above, for the same reason:
# these three are GNU, and a Mac has none of them. Left on their own they are
# three yellow warnings on every macOS target about tools that platform never
# had - so each is paired with what answers the same question there. hi already
# falls back at runtime (`timeout` is optional in common/targets.sh, and the
# header's CPU line degrades to "?"), and the check should say the same thing.

timeout:4,gtimeout:4
lscpu:4,nproc:4,sysctl:4
df:4
stat:4

# Platform-specific by nature: a missing one is information about the host
# rather than about the install. The first three are one row on purpose - they
# answer the same question, and no machine has two of them. sw_vers first so
# macOS reports the macOS-only name, wmic next for Windows, sysctl last as the
# one everything else answers with.

sw_vers:0,wmic:0,sysctl:0
lesspipe:0

