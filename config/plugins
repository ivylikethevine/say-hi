# The plugins: every config of a tool's that hi carries to a target and
# points the tool at, a `[<group>.<name>]` table each, in as much of TOML as
# hi reads: one `key = "value"` to a line. <group> is the section a list
# draws it under (editors, mux, prompt, cli, shell, hooks); <name> is the
# plugin, its word in $_HI_PLUGINS_OFF and its name in a report.
#
# files   the members, a space apart, each the name a file rides under: a
#         tool's own file name under its directory (vim/vimrc), its own name
#         where the tool keeps none (inputrc), a directory whose files ride
#         one by one (zellij/layouts/).
# tool    the commands that read them, a space apart: home's copy rides with
#         any of them on this machine. Left out, it is <name>; - asks about
#         nothing (a shell, readline, a prompt program).
# wire    points the tool at a member on a target: env:<variables> exports
#         each as the member's path, envdir:<variables> as its directory
#         (<variable>=<word> among them exports that word),
#         flag:<command> <flag> aliases the command to itself, the flag and
#         the path (<names>=<command> to answer to other names, words holding
#         a = before the command its environment), flagdir: the same with the
#         directory, xdg:<command> aliases it with $XDG_CONFIG_HOME set to
#         the overlay, the fallback for a file no variable or flag reaches
#         (what the command starts inherits the variable); several a ; apart;
#         left out or -, none.
# home    where a file is here, best first: paths a : apart, each starting at
#         /, ~/, or $NAME; several a , apart are one place, the first whose
#         variable is set; one ending in / a directory the member's file is
#         looked for in; left out or -, none; @<function>, in this file
#         alone, a lookup of scripts/pack.sh's that no list can say.
# dialect how the include scan and the comment strip read a file, a row of
#         scripts/pack.sh's $_HI_DIALECTS: sh, fish, vim, lua, elisp, nano,
#         tmux, screen, readline, kak, kdl, omp, omp-json, omz, omb, bash-it
#         (a framework's theme), git (keys and credentials stay home), or
#         conf (# comments, no includes); left out
#         or -, it rides as written.
# init    the tool's shell hook: a command printing a shell's code, {shell}
#         in it the shell's name (zoxide init {shell}). A target runs it,
#         where it has the tool, after the aliases and extensions; a
#         plugin with an init needs no files, and with a tool of - the
#         init's own command is the one asked for. HI.67.
# prompt  yes when the init draws the prompt: the plugin is then a prompt
#         program of $_HI_PROMPT_TOOL's, and hi stands its own prompt down.
# shells  the shells the init runs in, a space apart, of bash, zsh, and
#         fish; left out, all three.
# env     variables, a space apart, whose values on this machine a target's
#         session exports: each that is set here, as it is when you connect.
#         A plugin with an env needs no files; a value holding a quote, a
#         backslash, or a line break stays home. HI.62.
# default off keeps the plugin home, hook and files, until $_HI_PLUGINS_ON
#         names it (hi --plugin-on); left out, on.
#
# A `[<group>.<name>."<member>"]` table under a plugin gives that one of its
# files a wire, a home, or a dialect of its own.
#
# The comment right above a plugin's table is what `hi --configure` says of
# it, to its first full stop.
#
# `hi --add-plugin` writes a table to ~/.config/say-hi/plugins, which adds to
# this file, or replaces the plugin of the same name; `hi --plugins` lists
# what rides.

# vim starts on your vimrc
[editors.vim]
wire = "env:_HI_VIMRC;flag:vim=XDG_STATE_HOME=$_HI_HOME/vim/state XDG_DATA_HOME=$_HI_HOME/vim/data XDG_CACHE_HOME=$_HI_HOME/vim/cache vim -i NONE -u"
home = "~/.vimrc : ~/.vim/vimrc : $_HI_XDG_CONFIG/vim/vimrc"
dialect = "vim"
files = "vim/vimrc"

# nvim starts on your init.lua or init.vim
[editors.nvim]
wire = "env:_HI_NVIMRC;flag:nvim=XDG_STATE_HOME=$_HI_HOME/nvim/state XDG_DATA_HOME=$_HI_HOME/nvim/data XDG_CACHE_HOME=$_HI_HOME/nvim/cache nvim -u"
home = "$_HI_XDG_CONFIG/nvim/"
dialect = "lua"
files = "nvim/init.vim nvim/init.lua"

[editors.nvim."nvim/init.vim"]
dialect = "vim"

# nano starts on your nanorc
[editors.nano]
wire = "env:_HI_NANORC;flag:nano --rcfile"
home = "~/.nanorc : $_HI_XDG_CONFIG/nano/nanorc"
dialect = "nano"
files = "nano/nanorc"

# emacs -nw starts on your init.el
[editors.emacs]
wire = "flag:emacs -nw -q -l"
home = "~/.emacs.el : ~/.emacs : ~/.emacs.d/init.el : $_HI_XDG_CONFIG/emacs/init.el"
dialect = "elisp"
files = "emacs/init.el"

# helix starts on your config.toml
[editors.hx]
tool = "hx helix"
wire = "flag:hx -c;flag:helix -c"
home = "$_HI_XDG_CONFIG/helix/"
files = "helix/config.toml helix/languages.toml"

[editors.hx."helix/languages.toml"]
wire = "xdg:hx;xdg:helix"

# kakoune reads your kakrc and colors
[editors.kak]
wire = "envdir:KAKOUNE_CONFIG_DIR"
home = "$KAKOUNE_CONFIG_DIR/ , $XDG_CONFIG_HOME/kak/ , ~/.config/kak/"
dialect = "kak"
files = "kak/kakrc kak/colors/"

[editors.kak."kak/colors/"]
wire = "-"

# micro starts on your settings
[editors.micro]
wire = "flagdir:micro -backup false -savehistory false -config-dir"
home = "$MICRO_CONFIG_HOME/ , $XDG_CONFIG_HOME/micro/ , ~/.config/micro/"
files = "micro/settings.json micro/bindings.json micro/init.lua"

[editors.micro."micro/init.lua"]
dialect = "lua"

# your ~/.aliases, after hi's own
[shell.aliases]
tool = "-"
home = "~/.aliases : ~/.bash_aliases"
dialect = "sh"
files = "aliases.sh"

# the overlay's bashrc, read by bash
[shell.bash]
tool = "-"
dialect = "sh"
files = "bashrc"

# the overlay's zshrc, read by zsh
[shell.zsh]
tool = "-"
dialect = "sh"
files = "zshrc"

# the overlay's config.fish, read by fish
[shell.fish]
tool = "-"
dialect = "fish"
files = "config.fish"

# your extensions/ scripts, each sourced
[shell.extensions]
tool = "-"
dialect = "sh"
files = "extensions/"

# your bin/ scripts, on $PATH there
[shell.bin]
tool = "-"
files = "bin/"

# your pager and color variables
[shell.env]
tool = "-"
default = "off"
env = "LESS CLICOLOR LSCOLORS LS_COLORS EZA_COLORS GREP_COLORS GCC_COLORS JQ_COLORS BAT_THEME"

# the prompt, by your starship.toml
[prompt.starship]
tool = "-"
init = "starship init {shell}"
prompt = "yes"
wire = "env:STARSHIP_CONFIG"
home = "$STARSHIP_CONFIG , ~/.config/starship.toml"
files = "starship.toml"

# zsh's prompt, by your p10k.zsh
[prompt.powerlevel10k]
tool = "-"
home = "$POWERLEVEL9K_CONFIG_FILE , $ZDOTDIR/.p10k.zsh , ~/.p10k.zsh"
dialect = "sh"
files = "p10k.zsh"

# fish's prompt, by your tide setup
[prompt.tide]
tool = "-"
home = "$XDG_CONFIG_HOME/fish/fish_variables , ~/.config/fish/fish_variables"
files = "tide.vars"

# the prompt, by your theme file
[prompt.oh-my-posh]
tool = "-"
init = "oh-my-posh init {shell}"
prompt = "yes"
wire = "env:POSH_CONFIG POSH_THEME"
home = "@_hi_posh_home"
dialect = "omp"
files = "oh-my-posh.json oh-my-posh.yaml oh-my-posh.toml"

[prompt.oh-my-posh."oh-my-posh.json"]
dialect = "omp-json"

# zsh's prompt, by your theme
[prompt.oh-my-zsh]
tool = "-"
home = "@_hi_theme_home"
dialect = "omz"
files = "oh-my-zsh.zsh-theme"

# bash's prompt, by your theme
[prompt.oh-my-bash]
tool = "-"
home = "@_hi_theme_home"
dialect = "omb"
files = "oh-my-bash.theme.sh"

# bash's prompt, by your theme
[prompt.bash-it]
tool = "-"
home = "@_hi_theme_home"
dialect = "bash-it"
files = "bash-it.theme.bash"

# eza colors listings by your theme.yml
[cli.eza]
wire = "envdir:EZA_CONFIG_DIR"
home = "$EZA_CONFIG_DIR/theme.yml , $XDG_CONFIG_HOME/eza/theme.yml , ~/.config/eza/theme.yml"
files = "eza/theme.yml"

# bat reads your config: theme, style
[cli.bat]
tool = "bat batcat"
wire = "env:BAT_CONFIG_PATH"
home = "$BAT_CONFIG_PATH , $BAT_CONFIG_DIR/config , $XDG_CONFIG_HOME/bat/config , ~/.config/bat/config"
files = "bat/config"

# ripgrep reads your ripgreprc
[cli.rg]
wire = "env:RIPGREP_CONFIG_PATH"
home = "$RIPGREP_CONFIG_PATH"
dialect = "conf"
files = "ripgreprc"

# fzf's default options are yours
[cli.fzf]
wire = "env:FZF_DEFAULT_OPTS_FILE"
home = "$FZF_DEFAULT_OPTS_FILE"
files = "fzfrc"

# lazygit reads your config.yml
[cli.lazygit]
wire = "env:LG_CONFIG_FILE"
home = "$LG_CONFIG_FILE : $XDG_CONFIG_HOME/lazygit/config.yml , ~/.config/lazygit/config.yml : ~/Library/Application Support/lazygit/config.yml"
files = "lazygit/config.yml"

# git's aliases and settings, no keys
[cli.git]
default = "off"
wire = "env:GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=include.path GIT_CONFIG_VALUE_0"
home = "$GIT_CONFIG_GLOBAL , ~/.gitconfig : $XDG_CONFIG_HOME/git/config , ~/.config/git/config"
dialect = "git"
files = "git/config"

# line editing follows your inputrc
[cli.readline]
tool = "-"
wire = "env:INPUTRC"
home = "$INPUTRC , ~/.inputrc"
dialect = "readline"
files = "inputrc"

# tmux starts on your tmux.conf
[mux.tmux]
wire = "flag:tmux -f"
home = "~/.tmux.conf : $_HI_XDG_CONFIG/tmux/tmux.conf"
dialect = "tmux"
files = "tmux/tmux.conf"

# screen starts on your screenrc
[mux.screen]
wire = "flag:screen -c"
home = "$SCREENRC , ~/.screenrc"
dialect = "screen"
files = "screenrc"

# zellij starts on your config and layouts
[mux.zellij]
wire = "flagdir:zellij --config-dir"
home = "$ZELLIJ_CONFIG_DIR/ , $XDG_CONFIG_HOME/zellij/ , ~/.config/zellij/"
dialect = "kdl"
files = "zellij/config.kdl zellij/layouts/ zellij/themes/"

# Shell hooks (HI.67): tools that install themselves into a shell and keep
# state under a target's $HOME (zoxide's database, atuin's history and its
# sync, direnv's allow list, mise's shims), so each is off until named in
# $_HI_PLUGINS_ON: `hi --plugin-on zoxide`.

# z jumps to the directories you visit
[hooks.zoxide]
init = "zoxide init {shell}"
default = "off"

# history search by atuin, on your config
[hooks.atuin]
init = "atuin init {shell}"
default = "off"
wire = "envdir:ATUIN_CONFIG_DIR"
home = "$ATUIN_CONFIG_DIR/config.toml , $XDG_CONFIG_HOME/atuin/config.toml , ~/.config/atuin/config.toml"
files = "atuin/config.toml"

# loads a directory's .envrc on entry
[hooks.direnv]
init = "direnv hook {shell}"
default = "off"

# activates the tools a directory pins
[hooks.mise]
init = "mise activate {shell}"
default = "off"
