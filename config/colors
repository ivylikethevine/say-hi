# Color pins, in as much of TOML as hi reads: a `[type]` line starts a table,
# and each row under it is `name = "color"` or `name = "color rrggbb"`, on one
# line. `hi --set-color <type> <name> <color> [rrggbb]` and
# `hi --unset-color <type> <name>` edit ~/.config/say-hi/colors, copying this
# file there on the first write; that copy replaces this one wholesale.
#
# type  = hosttag | username | hostname | usertag
# usertag colors the username on every host carrying that # Tags: value
# color = red, green, yellow, blue, magenta, cyan, brred, brgreen, bryellow,
#   brblue, brmagenta, brcyan (the terminal's own sixteen), or orange, pink,
#   teal, lime, violet, salmon, gold, sky, indigo, mint, peach, lavender (a
#   24-bit color of their own on a truecolor terminal, the nearest of the
#   sixteen elsewhere)
# a second word in the string is that pin's own 24-bit color, six hex digits
# (a leading # is fine): `prod-db = "brred ff5f5f"` under [hostname] renders
# prod-db in exactly that red on a truecolor terminal. The color still has to be
# a name from the list above and is what a 16-color terminal gets, so pick
# the nearest one. It beats _HI_COLOR_SCHEME, which says what a *name*
# renders as; six hex digits is the whole of what is accepted, and anything
# else is ignored and the row colors by its name alone.
# a name that is not letters, digits, _ and - alone goes in double quotes.
# a hostname name holding * or ? is a pattern: `"10.0.1.*" = "red"` colors
# a whole subnet or domain at once. An exact pin and a hosttag both beat it.
# LOCALUSER and LOCALHOSTNAME are special username/hostname names that match
# the user/host of the machine say-hi is installed on, wherever that user/host
# shows up - e.g. `LOCALUSER = "green"` colors your own username green
# even after ssh'ing into a machine where you're logged in under that same
# name, without hardcoding the name itself. an exact username or hostname pin
# still takes priority over these.
# anything with no pin at all falls back to a hash of the name.
# run `hi --preview colors` to preview what everything currently resolves to.

[hosttag]
terminal        = "brmagenta"
baremetal       = "brred"
personal        = "brblue"
work            = "brgreen"
windows         = "bryellow"

[username]
root            = "red b00020"
admin           = "magenta"
ubuntu          = "yellow"
debian          = "blue"
LOCALUSER       = "bryellow"

[usertag]
personal        = "green"

[hostname]
LOCALHOSTNAME   = "brmagenta"
